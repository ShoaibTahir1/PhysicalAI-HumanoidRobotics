# Physical AI & Humanoid Robotics Book - Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# AUTHENTICATION (Better-Auth)
# =============================================================================
BETTER_AUTH_SECRET=your-secret-key-here-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# DATABASE (Neon Postgres)
# =============================================================================
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgres://user:password@ep-xxx.region.neon.tech/physicalai?sslmode=require

# =============================================================================
# VECTOR DATABASE (Qdrant Cloud)
# =============================================================================
# Get your credentials from https://cloud.qdrant.io
QDRANT_URL=https://xxx-xxx-xxx.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# =============================================================================
# OPENAI (RAG Chatbot)
# =============================================================================
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ROUTER_ID=your-openai-router-id

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Site URL for GitHub Pages deployment
SITE_URL=https://ShoaibTahir1.github.io/PhysicalAI-HumanoidRobotics

# GitHub repository for deployment
GITHUB_REPO=ShoaibTahir1/PhysicalAI-HumanoidRobotics

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
NODE_ENV=development
